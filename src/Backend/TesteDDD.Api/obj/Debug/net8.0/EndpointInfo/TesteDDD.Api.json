  "components": {
    "schemas": {
      "RequestCategoriaJson": {
        "required": [
          "descricao",
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "descricao": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RequestClienteJson": {
        "required": [
          "cep",
          "endereco",
          "nome"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "endereco": {
            "maxLength": 250,
            "minLength": 1,
            "type": "string"
          },
          "cep": {
            "minLength": 1,
            "pattern": "^\\d{5}-?\\d{3}$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RequestProdutoJson": {
        "required": [
          "nome"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "preco": {
            "maximum": 9999999999,
            "minimum": 0,01,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      }
    }
